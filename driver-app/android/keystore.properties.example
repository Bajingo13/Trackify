# Copy to keystore.properties (which is gitignored) and fill in.
#
# Generate the keystore once, and then never lose it: Google Play identifies
# your app by this key, and an app signed with a different one cannot update
# the existing listing — only be published as a separate app.
#
#   keytool -genkey -v -keystore trackify-release.jks \
#       -keyalg RSA -keysize 2048 -validity 10000 -alias trackify
#
# Back the .jks file up somewhere that is not this machine.

storeFile=../trackify-release.jks
storePassword=
keyAlias=trackify
keyPassword=
