node_modules/
dist/
build/
.cache/
.env*
!.env.example
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Generated documents and working notes — not part of the system
Daily_Report_*
Daily_Task_Log_*
*.pdf

# Database dumps and copied evidence files. A backup contains every receipt,
# licence and delivery photo in the system; it must never reach the repository.
backups/
backend/backups/
