# ============================================================
# AstreaBlue Trackify — Environment Configuration (EXAMPLE)
# Copy this file to `.env` (repo root) and fill in the real local values.
# A SINGLE root .env serves both apps: the backend loads it via
# backend/config/env.js; the frontend (Vite) reads it via `envDir`.
# NEVER commit a real `.env` (it is gitignored).
# ============================================================

# --- Runtime ---
NODE_ENV=development

# Backend HTTP port (Express).
PORT=5000

# Frontend origin, used for CORS on the backend.
FRONTEND_URL=http://localhost:8443
# Optional: extra allowed browser origins, comma-separated. In development any
# localhost / 127.0.0.1 / LAN origin is already allowed automatically.
# CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# --- MySQL (backend/config/db.js) ---
# Use the dedicated application user, NOT root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=trackify_dev
DB_PASSWORD=
DB_NAME=trackify

# Railway supplies equivalent MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD,
# and MYSQLDATABASE variables when they are referenced from its MySQL service.
# No DB_* aliases are required in that environment.

# --- Authentication ---
# Generate a strong local value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Local development admin seed (backend/scripts/seedAdmin.js) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@astreablue.com
SEED_ADMIN_PASSWORD=

# Shared password for the per-role demo users (npm run db:seed-demo)
SEED_DEMO_PASSWORD=demo123

# --- Frontend (Vite, exposed to browser) ---
VITE_API_URL=http://localhost:5000

# Persistent receipt/POD storage. On Railway, attach a volume with mount path
# /data/uploads; Railway exposes that path automatically through
# RAILWAY_VOLUME_MOUNT_PATH, so UPLOAD_ROOT is only an optional explicit override.
# UPLOAD_ROOT=/data/uploads

# --- Maps ---
# OpenStreetMap's public tile server is free community infrastructure whose
# usage policy does not cover production commercial traffic. Before real load,
# point these at a provider of your own (MapTiler, Mapbox, or self-hosted).
# Both must change together: the frontend requests the tiles, the backend's
# Content-Security-Policy decides whether the browser is allowed to load them.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# MAP_TILE_HOSTS=https://api.maptiler.com

# --- Native driver app (Capacitor) ---------------------------------------
# The native app has no same-origin server to fall back on: inside its webview
# "localhost" is the handset, so the API has to be named outright. Point this
# at the deployed backend for a release build.
#
#   real device / release   https://trackify-backend-production-a447.up.railway.app
#   android emulator        http://10.0.2.2:5000   (the emulator's route to this PC)
#   phone on the same wifi  http://<this-pc-lan-ip>:5000
#
# Unset, the app falls back to the emulator address, which is the only guess
# that can be right during development.
VITE_DRIVER_API_URL=
