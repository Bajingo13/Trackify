# ============================================================
# AstreaBlue Trackify — Environment Configuration (EXAMPLE)
# Copy this file to `.env` (repo root) and fill in the real local values.
# A SINGLE root .env serves both apps: the backend loads it via
# backend/config/env.js; the frontend (Vite) reads it via `envDir`.
# NEVER commit a real `.env` (it is gitignored).
# ============================================================

# --- Runtime ---
NODE_ENV=development

# Backend HTTP port (Express).
PORT=5000

# Frontend origin, used for CORS on the backend.
FRONTEND_URL=http://localhost:8443
# Optional: extra allowed browser origins, comma-separated. In development any
# localhost / 127.0.0.1 / LAN origin is already allowed automatically.
# CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# --- MySQL (backend/config/db.js) ---
# Use the dedicated application user, NOT root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=trackify_dev
DB_PASSWORD=
DB_NAME=trackify

# --- Authentication ---
# Generate a strong local value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Local development admin seed (backend/scripts/seedAdmin.js) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@astreablue.com
SEED_ADMIN_PASSWORD=

# Shared password for the per-role demo users (npm run db:seed-demo)
SEED_DEMO_PASSWORD=demo123

# --- Frontend (Vite, exposed to browser) ---
VITE_API_URL=http://localhost:5000
